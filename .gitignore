# 建構/發佈輸出（封裝的遊戲版本，不進版本控制，用壓縮檔另外備份或發佈）
builds/*
!builds/.gitkeep

# 作業系統
.DS_Store
Thumbs.db
desktop.ini

# 編輯器
.vscode/
.idea/

# 環境變數
.env

# VOICEVOX 試聽檔（tools/voicevox_samples.ps1 產生）
voice_samples/

# iOS App（Capacitor）：npm 套件、npm run build 的輸出（Xcode 專案 ios/ 要進 git）
node_modules/
www/

# 宣傳圖／App Store 截圖（tools/promo_maker.html 產生，隨時可以重新輸出）
promo/store/

# Office 開檔時的暫存鎖定檔（例如用 Word 打開 docs 裡的文件）
~$*
