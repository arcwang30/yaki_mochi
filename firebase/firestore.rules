rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 排行榜（每首歌一個集合）：任何人可讀，只能新增（不可改、不可刪），且欄位須符合格式
    match /{col}/{doc} {
      allow read: if col in ['leaderboard_tsukimi', 'leaderboard_yatai', 'leaderboard_swing', 'leaderboard_funk', 'leaderboard_hyper',
                    'leaderboard_bossa', 'leaderboard_chindon', 'leaderboard_ska', 'leaderboard_chip', 'leaderboard_dnb',
                    'leaderboard_musicbox', 'leaderboard_reggae', 'leaderboard_citypop', 'leaderboard_ondo', 'leaderboard_samba',
                    'leaderboard_surf', 'leaderboard_disco', 'leaderboard_boogie', 'leaderboard_jrock', 'leaderboard_hoedown',
                    'leaderboard_gamelan', 'leaderboard_hawaii', 'leaderboard_synthwave', 'leaderboard_future', 'leaderboard_anime',
                    'leaderboard_britpop', 'leaderboard_dancepunk', 'leaderboard_thrash', 'leaderboard_power', 'leaderboard_wametal'];
      allow create: if col in ['leaderboard_tsukimi', 'leaderboard_yatai', 'leaderboard_swing', 'leaderboard_funk', 'leaderboard_hyper',
                    'leaderboard_bossa', 'leaderboard_chindon', 'leaderboard_ska', 'leaderboard_chip', 'leaderboard_dnb',
                    'leaderboard_musicbox', 'leaderboard_reggae', 'leaderboard_citypop', 'leaderboard_ondo', 'leaderboard_samba',
                    'leaderboard_surf', 'leaderboard_disco', 'leaderboard_boogie', 'leaderboard_jrock', 'leaderboard_hoedown',
                    'leaderboard_gamelan', 'leaderboard_hawaii', 'leaderboard_synthwave', 'leaderboard_future', 'leaderboard_anime',
                    'leaderboard_britpop', 'leaderboard_dancepunk', 'leaderboard_thrash', 'leaderboard_power', 'leaderboard_wametal']
        && request.resource.data.keys().hasOnly(['name', 'score', 'oko', 'combo', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 8
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 999999
        && request.resource.data.oko is int
        && request.resource.data.oko >= 0 && request.resource.data.oko <= 200
        && request.resource.data.combo is int
        && request.resource.data.combo >= 0 && request.resource.data.combo <= 2000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
