rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 排行榜：任何人可讀，只能新增（不可改、不可刪），且欄位須符合格式
    match /leaderboard/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'oko', 'combo', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 8
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 999999
        && request.resource.data.oko is int
        && request.resource.data.oko >= 0 && request.resource.data.oko <= 200
        && request.resource.data.combo is int
        && request.resource.data.combo >= 0 && request.resource.data.combo <= 2000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
